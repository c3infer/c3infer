+/**
+ * rmi_set_protected_shared_range() - Set protected shared range	
+ * @rd: PA of the RD
+ * @ipa: IPA at which the granule will be mapped in the guest
+ * @size: Size of the range
+ *
+ * Return: RMI return code
+ */
+static inline int rmi_set_protected_shared_range(unsigned long rd,
+					  unsigned long ipa,
+					  unsigned long size)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_1_1_invoke(SMC_RMI_SET_PROTECTED_SHARED_RANGE, rd, ipa, size, &res);
+
+	return res.a0;
+}
+
+/**
+ * rmi_bind_protected_shared() - Bind page to an already existing DATA granule in protected shared range
+ * @rd: PA of the RD
+ * @ipa: IPA at which the granule will be mapped in the guest
+ *
+ * Return: RMI return code
+ */
+static inline int rmi_bind_protected_shared(unsigned long rd,
+					  unsigned long ipa)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_1_1_invoke(SMC_RMI_BIND_PROTECTED_SHARED, rd, ipa, &res);
+
+	return res.a0;
+}
