index 44ac4d80adb2..6435289df8da 100644
--- a/arch/arm64/kvm/mmu.c
+++ b/arch/arm64/kvm/mmu.c
@@ -1551,7 +1551,7 @@ static int realm_map_ipa_protected_shared(struct kvm *kvm, phys_addr_t ipa, //co
 
 	ipa = ALIGN_DOWN(ipa, PAGE_SIZE);
 
