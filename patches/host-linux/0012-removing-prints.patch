+	// pr_info("realm_map_protected_shared: SUCCESS for base_ipa=0x%lx map_size=0x%lx\n",
+	// 	base_ipa, map_size);
 	return 0;
 
 err_undelegate:
-	pr_info("realm_map_protected_shared: err_undelegate phys=0x%llx size=0x%lx ipa=0x%lx\n",
