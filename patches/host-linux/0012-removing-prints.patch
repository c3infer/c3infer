+		// pr_info("realm_map_protected_shared: rmi_granule_undelegate(0x%llx) FAILED, leaking page\n",
+		//        (unsigned long long)phys);
 		get_page(phys_to_page(phys));
 	}
 err:
@@ -1128,20 +1128,20 @@ int realm_map_protected_shared(struct realm *realm,
 		size -= RMM_PAGE_SIZE;
 		ipa -= RMM_PAGE_SIZE;
 
