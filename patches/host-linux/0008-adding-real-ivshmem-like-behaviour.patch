From: Amir Al Sadi <alsadi.amir@gmail.com>
Date: Fri, 24 Oct 2025 18:16:51 +0100
Subject: [PATCH 08/14] adding real ivshmem-like behaviour

---
 arch/arm64/include/asm/rmi_cmds.h |   3 +-
 arch/arm64/kvm/mmu.c              | 142 +++++++++++++++++-------------
 arch/arm64/kvm/rme.c              |  21 +++--
 3 files changed, 92 insertions(+), 74 deletions(-)

diff --git a/arch/arm64/include/asm/rmi_cmds.h b/arch/arm64/include/asm/rmi_cmds.h
index 5d79f9b06092..6ab3238c9896 100644
--- a/arch/arm64/include/asm/rmi_cmds.h
+++ b/arch/arm64/include/asm/rmi_cmds.h
@@ -87,11 +87,12 @@ static inline int rmi_set_protected_shared_range(unsigned long rd,
  * Return: RMI return code
  */
 static inline int rmi_bind_protected_shared(unsigned long rd,
+					  unsigned long pa,
 					  unsigned long ipa)
 {
 	struct arm_smccc_res res;
 
-	arm_smccc_1_1_invoke(SMC_RMI_BIND_PROTECTED_SHARED, rd, ipa, &res);
+	arm_smccc_1_1_invoke(SMC_RMI_BIND_PROTECTED_SHARED, rd, pa, ipa, &res);
 
 	return res.a0;
 }
diff --git a/arch/arm64/kvm/mmu.c b/arch/arm64/kvm/mmu.c
index 3b384a15bd27..8f7c25236abc 100644
--- a/arch/arm64/kvm/mmu.c
+++ b/arch/arm64/kvm/mmu.c
@@ -1582,86 +1582,84 @@ static int private_memslot_fault(struct kvm_vcpu *vcpu,
 	gpa_t gpa = kvm_gpa_from_fault(kvm, fault_ipa);
 	gfn_t gfn = gpa >> PAGE_SHIFT;
 	bool is_priv_gfn = kvm_mem_is_private(kvm, gfn);
-	bool is_priv_sh_gfn = kvm_mem_is_private_shared(kvm, gfn);
 	// bool is_priv_sh_committed = kvm_mem_is_private_shared_committed(kvm, gfn);
 	struct kvm_mmu_memory_cache *memcache = &vcpu->arch.mmu_page_cache;
 	struct page *page;
 	kvm_pfn_t pfn;
 	int ret;
- 
-	if (is_priv_sh_gfn) {
-		ret = kvm_mmu_topup_memory_cache(memcache,
-					kvm_mmu_cache_min_pages(vcpu->arch.hw_mmu));
-		if (ret)
-			return ret;
+	/*
+	* For Realms, the shared address is an alias of the private GPA with
+	* the top bit set. Thus is the fault address matches the GPA then it
+	* is the private alias.
+	*/
+	bool is_priv_fault = (gpa == fault_ipa);
 
-		ret = kvm_gmem_get_pfn(kvm, memslot, gfn, &pfn, &page, NULL);
-		if (ret)
-			return ret;
+	if (is_priv_gfn != is_priv_fault) {
+		kvm_prepare_memory_fault_exit(vcpu, gpa, PAGE_SIZE,
+						kvm_is_write_fault(vcpu), false,
+						is_priv_fault);
 
-		u32 prot = KVM_PGTABLE_PROT_R | KVM_PGTABLE_PROT_W;
-		pr_info("Hit PROTECTED_SHARED bind route for private shared IPA 0x%llx\n",
-				    (unsigned long long)fault_ipa);
-		ret = realm_bind_ipa_protected_shared(kvm, fault_ipa, pfn, PAGE_SIZE, prot,
-						memcache);
-		if (!ret){
-			return 1; /* Handled */
-		} else {
-			/* FIXME: Should be able to use bigger than PAGE_SIZE mappings */
-			ret = realm_map_ipa_protected_shared(kvm, fault_ipa, pfn, PAGE_SIZE, prot,
-						memcache);
-			if (!ret)
-				return 1; /* Handled */
-		}
-	} else {
 		/*
-		* For Realms, the shared address is an alias of the private GPA with
-		* the top bit set. Thus is the fault address matches the GPA then it
-		* is the private alias.
+		* KVM_EXIT_MEMORY_FAULT requires an return code of -EFAULT,
+		* see the API documentation
 		*/
-		bool is_priv_fault = (gpa == fault_ipa);
-
-		if (is_priv_gfn != is_priv_fault) {
-			kvm_prepare_memory_fault_exit(vcpu, gpa, PAGE_SIZE,
-							kvm_is_write_fault(vcpu), false,
-							is_priv_fault);
-
-			/*
-			* KVM_EXIT_MEMORY_FAULT requires an return code of -EFAULT,
-			* see the API documentation
-			*/
-			return -EFAULT;
-		}
+		return -EFAULT;
+	}
 
-		if (!is_priv_fault) {
-			/* Not a private mapping, handling normally */
-			return -EINVAL;
-		}
+	if (!is_priv_fault) {
+		/* Not a private mapping, handling normally */
+		return -EINVAL;
+	}
 
-		ret = kvm_mmu_topup_memory_cache(memcache,
-						kvm_mmu_cache_min_pages(vcpu->arch.hw_mmu));
-		if (ret)
-			return ret;
+	ret = kvm_mmu_topup_memory_cache(memcache,
+					kvm_mmu_cache_min_pages(vcpu->arch.hw_mmu));
+	if (ret)
+		return ret;
 
-		ret = kvm_gmem_get_pfn(kvm, memslot, gfn, &pfn, &page, NULL);
-		if (ret)
-			return ret;
+	ret = kvm_gmem_get_pfn(kvm, memslot, gfn, &pfn, &page, NULL);
+	if (ret)
+		return ret;
 
-		/* FIXME: Should be able to use bigger than PAGE_SIZE mappings */
-		ret = realm_map_ipa(kvm, fault_ipa, pfn, PAGE_SIZE, KVM_PGTABLE_PROT_W,
-					memcache);
-		if (!ret)
-			return 1; /* Handled */
-	}
+	/* FIXME: Should be able to use bigger than PAGE_SIZE mappings */
+	ret = realm_map_ipa(kvm, fault_ipa, pfn, PAGE_SIZE, KVM_PGTABLE_PROT_W,
+				memcache);
+	if (!ret)
+		return 1; /* Handled */
 
 	put_page(page);
 	return ret;
 }
 
+	// if (is_priv_sh_gfn) {
+	// 	ret = kvm_mmu_topup_memory_cache(memcache,
+	// 				kvm_mmu_cache_min_pages(vcpu->arch.hw_mmu));
+	// 	if (ret)
+	// 		return ret;
+
+	// 	ret = kvm_gmem_get_pfn(kvm, memslot, gfn, &pfn, &page, NULL);
+	// 	if (ret)
+	// 		return ret;
+
+	// 	u32 prot = KVM_PGTABLE_PROT_R | KVM_PGTABLE_PROT_W;
+	// 	pr_info("Hit PROTECTED_SHARED bind route for private shared IPA 0x%llx\n",
+	// 			    (unsigned long long)fault_ipa);
+	// 	ret = realm_bind_ipa_protected_shared(kvm, fault_ipa, pfn, PAGE_SIZE, prot,
+	// 					memcache);
+	// 	if (!ret){
+	// 		return 1; /* Handled */
+	// 	} else {
+	// 		/* FIXME: Should be able to use bigger than PAGE_SIZE mappings */
+	// 		ret = realm_map_ipa_protected_shared(kvm, fault_ipa, pfn, PAGE_SIZE, prot,
+	// 					memcache);
+	// 		if (!ret)
+	// 			return 1; /* Handled */
+	// 	}
+	// } 
+
 static int user_mem_abort(struct kvm_vcpu *vcpu, phys_addr_t fault_ipa,
 			  struct kvm_s2_trans *nested,
 			  struct kvm_memory_slot *memslot, unsigned long hva,
-			  bool fault_is_perm)
+			  bool fault_is_perm, bool is_priv_sh_gfn)
 {
 	int ret = 0;
 	bool write_fault, writable, force_pte = false;
@@ -1957,8 +1955,26 @@ static int user_mem_abort(struct kvm_vcpu *vcpu, phys_addr_t fault_ipa,
 		prot &= ~KVM_NV_GUEST_MAP_SZ;
 		ret = KVM_PGT_FN(kvm_pgtable_stage2_relax_perms)(pgt, fault_ipa, prot, flags);
 	} else if (kvm_is_realm(kvm)) {
-		ret = realm_map_ipa(kvm, fault_ipa, pfn, vma_pagesize,
-				    prot, memcache);
+		if (is_priv_sh_gfn){
+			u32 prot = KVM_PGTABLE_PROT_R | KVM_PGTABLE_PROT_W;
+			pr_info("Hit PROTECTED_SHARED bind route for private shared IPA 0x%llx\n",
+						(unsigned long long)fault_ipa);
+			ret = realm_bind_ipa_protected_shared(kvm, fault_ipa, pfn, PAGE_SIZE, prot,
+							memcache);
+			if (!ret){
+				return 1; /* Handled */
+			} else {
+				/* FIXME: Should be able to use bigger than PAGE_SIZE mappings */
+				ret = realm_map_ipa_protected_shared(kvm, fault_ipa, pfn, PAGE_SIZE, prot,
+							memcache);
+				if (!ret)
+					return 1; /* Handled */
+			}
+		} else{
+			ret = realm_map_ipa(kvm, fault_ipa, pfn, vma_pagesize,
+								prot, memcache);
+		}
+		
 	} else {
 		ret = KVM_PGT_FN(kvm_pgtable_stage2_map)(pgt, fault_ipa, vma_pagesize,
 					     __pfn_to_phys(pfn), prot,
@@ -2172,8 +2188,10 @@ int kvm_handle_guest_abort(struct kvm_vcpu *vcpu)
 		goto out_unlock;
 	}
 
+	struct kvm *kvm = vcpu->kvm;
+	bool is_priv_sh_gfn = kvm_mem_is_private_shared(kvm, gfn);
 	ret = user_mem_abort(vcpu, fault_ipa, nested, memslot, hva,
-			     esr_fsc_is_permission_fault(esr));
+			     esr_fsc_is_permission_fault(esr), is_priv_sh_gfn);
 	if (ret == 0)
 		ret = 1;
 out:
diff --git a/arch/arm64/kvm/rme.c b/arch/arm64/kvm/rme.c
index 9428b49dc943..a9613e55053c 100644
--- a/arch/arm64/kvm/rme.c
+++ b/arch/arm64/kvm/rme.c
@@ -1056,7 +1056,6 @@ int realm_map_protected_shared(struct realm *realm,
 }
 
 
-
 int realm_map_non_secure(struct realm *realm,
 			 unsigned long ipa,
 			 kvm_pfn_t pfn,
@@ -1391,16 +1390,16 @@ int realm_bind_protected_shared(struct realm *realm,
 	}
 
 	for (size = 0; size < map_size; size += RMM_PAGE_SIZE) {
-		if (rmi_granule_delegate(phys)) {
-			/*
-			 * It's likely we raced with another VCPU on the same
-			 * fault. Assume the other VCPU has handled the fault
-			 * and return to the guest.
-			 */
-			return 0;
-		}
+		// if (rmi_granule_delegate(phys)) {
+		// 	/*
+		// 	 * It's likely we raced with another VCPU on the same
+		// 	 * fault. Assume the other VCPU has handled the fault
+		// 	 * and return to the guest.
+		// 	 */
+		// 	return 0;
+		// }
 
-		ret = rmi_bind_protected_shared(virt_to_phys(realm->rd), ipa);
+		ret = rmi_bind_protected_shared(virt_to_phys(realm->rd), phys, ipa);
 
 		if (RMI_RETURN_STATUS(ret) == RMI_ERROR_RTT) {
 			/* Create missing RTTs and retry */
@@ -1414,7 +1413,7 @@ int realm_bind_protected_shared(struct realm *realm,
 			if (ret)
 				goto err_undelegate;
 
-			ret = rmi_bind_protected_shared(virt_to_phys(realm->rd), ipa);
+			ret = rmi_bind_protected_shared(virt_to_phys(realm->rd), phys, ipa);
 		}
 
 		if (WARN_ON(ret))
