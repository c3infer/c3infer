Subject: [PATCH 11/14] support for rw checking in policy

---
 arch/arm64/include/asm/kvm_rme.h  |   2 +
 arch/arm64/include/asm/rmi_cmds.h |  27 ++++----
 arch/arm64/include/asm/rmi_smc.h  |   1 +
 arch/arm64/kvm/mmu.c              |   3 +
 arch/arm64/kvm/rme.c              | 111 ++++++++++++++++++++++++++++--
 5 files changed, 125 insertions(+), 19 deletions(-)

diff --git a/arch/arm64/include/asm/kvm_rme.h b/arch/arm64/include/asm/kvm_rme.h
index 1eb5bb485736..d9c33d5c1482 100644
--- a/arch/arm64/include/asm/kvm_rme.h
+++ b/arch/arm64/include/asm/kvm_rme.h
@@ -50,6 +50,7 @@ enum realm_state {
  *
  * @state: The lifetime state machine for the realm
  * @rd: Kernel mapping of the Realm Descriptor (RD)
+ * @pd: Kernel mapping of the Policy Descriptor (PD)
  * @params: Parameters for the RMI_REALM_CREATE command
  * @num_aux: The number of auxiliary pages required by the RMM
  * @vmid: VMID to be used by the RMM for the realm
@@ -59,6 +60,7 @@ struct realm {
 	enum realm_state state;
 
 	void *rd;
+	void *pd;
 	struct realm_params *params;
 
 	unsigned long num_aux;
diff --git a/arch/arm64/include/asm/rmi_cmds.h b/arch/arm64/include/asm/rmi_cmds.h
index 6ab3238c9896..19c04c21c8f7 100644
--- a/arch/arm64/include/asm/rmi_cmds.h
+++ b/arch/arm64/include/asm/rmi_cmds.h
@@ -240,36 +240,37 @@ static inline int rmi_realm_activate(unsigned long rd)
 }
 
 /**
- * rmi_realm_custom_print() - Print a realm custom message
+ * rmi_realm_create() - Create a realm
  * @rd: PA of the RD
+ * @params: PA of realm parameters
  *
- * A debug print function to log on console.
+ * Create a new realm using the given parameters.
  *
  * Return: RMI return code
  */
-// static inline int rmi_realm_custom_print(unsigned long rd)
-// {
-// 	struct arm_smccc_res res;
+static inline int rmi_realm_create(unsigned long rd, unsigned long params)
+{
+	struct arm_smccc_res res;
 
-// 	arm_smccc_1_1_invoke(SMC_RMI_CUSTOM_PRINT, rd, &res);
+	arm_smccc_1_1_invoke(SMC_RMI_REALM_CREATE, rd, params, &res);
 
-// 	return res.a0;
-// }
+	return res.a0;
+}
 
 /**
- * rmi_realm_create() - Create a realm
+ * rmi_realm_pd() - assigns PD (policy descriptor) to realm
  * @rd: PA of the RD
- * @params: PA of realm parameters
+ * @pd: PA of the PD
  *
- * Create a new realm using the given parameters.
+ * Assigns address of PD granule for realm with RD rd.
  *
  * Return: RMI return code
  */
-static inline int rmi_realm_create(unsigned long rd, unsigned long params)
+static inline int rmi_realm_pd(unsigned long rd, unsigned long pd)
 {
 	struct arm_smccc_res res;
 
-	arm_smccc_1_1_invoke(SMC_RMI_REALM_CREATE, rd, params, &res);
+	arm_smccc_1_1_invoke(SMC_RMI_REALM_PD, rd, pd, &res);
 
 	return res.a0;
 }
diff --git a/arch/arm64/include/asm/rmi_smc.h b/arch/arm64/include/asm/rmi_smc.h
index c63355ea5462..ba08f83c1620 100644
--- a/arch/arm64/include/asm/rmi_smc.h
+++ b/arch/arm64/include/asm/rmi_smc.h
@@ -48,6 +48,7 @@
 #define SMC_RMI_DATA_CREATE_UNKNOWN_SHARED		SMC_RMI_CALL(0x016a)
 #define SMC_RMI_SET_PROTECTED_SHARED_RANGE		SMC_RMI_CALL(0x016b)
 #define SMC_RMI_BIND_PROTECTED_SHARED			SMC_RMI_CALL(0x016c)
+#define SMC_RMI_REALM_PD						SMC_RMI_CALL(0x016d)
 
 #define RMI_ABI_MAJOR_VERSION	1
 #define RMI_ABI_MINOR_VERSION	0
diff --git a/arch/arm64/kvm/mmu.c b/arch/arm64/kvm/mmu.c
index d3431242a281..44ac4d80adb2 100644
--- a/arch/arm64/kvm/mmu.c
+++ b/arch/arm64/kvm/mmu.c
@@ -1551,6 +1551,8 @@ static int realm_map_ipa_protected_shared(struct kvm *kvm, phys_addr_t ipa, //co
 
 	ipa = ALIGN_DOWN(ipa, PAGE_SIZE);
 
+	pr_info("realm_map_ipa_protected_shared: ipa=0x%lx map_size=%lx\n", (unsigned long)ipa, map_size);
+
 	return realm_map_protected_shared(realm, ipa, pfn, map_size, memcache);
 }
 
@@ -1965,6 +1967,7 @@ static int user_mem_abort(struct kvm_vcpu *vcpu, phys_addr_t fault_ipa,
 				ret = 0;
 				writable = true;
 			} else {
+				pr_info("Just got into realm_map_ipa_protected_shared BRANCH\n");
 				/* FIXME: Should be able to use bigger than PAGE_SIZE mappings */
 				ret = realm_map_ipa_protected_shared(kvm, fault_ipa, pfn, PAGE_SIZE, prot,
 							memcache);
diff --git a/arch/arm64/kvm/rme.c b/arch/arm64/kvm/rme.c
index a9613e55053c..b078cb406725 100644
--- a/arch/arm64/kvm/rme.c
+++ b/arch/arm64/kvm/rme.c
@@ -721,6 +721,46 @@ static int realm_create_rd(struct kvm *kvm)
 	return r;
 }
 
+static int realm_create_pd(struct kvm *kvm)
+{
+	struct realm *realm = &kvm->arch.realm;
+	void *pd = NULL;
+	phys_addr_t pd_phys;
+	phys_addr_t rd = virt_to_phys(realm->rd);
+	int r;
+
+	if (WARN_ON(realm->pd))
+		return -EEXIST;
+
+	pd = (void *)__get_free_page(GFP_KERNEL);
+	if (!pd)
+		return -ENOMEM;
+
+	pd_phys = virt_to_phys(pd);
+	if (rmi_granule_delegate(pd_phys)) {
+		r = -ENXIO;
+		goto free_pd;
+	}
+
+	if (rmi_realm_pd(rd, pd_phys)) {
+		r = -ENXIO;
+		goto out_undelegate_pd;
+	}
+
+	realm->pd = pd;
+
+	return 0;
+
+out_undelegate_pd:
+	if (WARN_ON(rmi_granule_undelegate(pd_phys))) {
+		/* Leak the page if it isn't returned */
+		return r;
+	}
+free_pd:
+	free_page((unsigned long)pd);
+	return r;
+}
+
 static void realm_unmap_private_range(struct kvm *kvm,
 				      unsigned long start,
 				      unsigned long end,
@@ -976,9 +1016,21 @@ int realm_map_protected_shared(struct realm *realm,
 			RMM_RTT_BLOCK_LEVEL : RMM_RTT_MAX_LEVEL;
 	int ret = 0;
 
+	pr_info("realm_map_protected_shared: enter ipa=0x%lx map_size=0x%lx pfn=0x%lx phys=0x%llx rd=0x%llx map_level=%d\n",
+		ipa, map_size, (unsigned long)pfn,
+		(unsigned long long)phys,
+		(unsigned long long)rd,
+		map_level);
+
 	if (WARN_ON(!IS_ALIGNED(map_size, RMM_PAGE_SIZE) ||
-		    !IS_ALIGNED(ipa, map_size)))
+		    !IS_ALIGNED(ipa, map_size))){
+		pr_err("realm_map_protected_shared: alignment FAIL ipa=0x%lx map_size=0x%lx (PAGE_SIZE=0x%lx)\n",
+		       ipa, map_size, (unsigned long)RMM_PAGE_SIZE);
+		WARN_ON(1);   /* keep the stacktrace for now */
 		return -EINVAL;
+	}
+	pr_info("realm_map_protected_shared: alignment OK ipa=0x%lx map_size=0x%lx\n",
+		ipa, map_size);
 
 	if (map_level < RMM_RTT_MAX_LEVEL) {
 		/*
@@ -986,12 +1038,18 @@ int realm_map_protected_shared(struct realm *realm,
 		 * however if there is an error (e.g. missing parent tables)
 		 * this will be handled below.
 		 */
+		pr_info("realm_map_protected_shared: pre-creating RTT levels: ipa=0x%lx map_level=%d..%d\n",
+			ipa, map_level, RMM_RTT_MAX_LEVEL);
 		realm_create_rtt_levels(realm, ipa, map_level,
 					RMM_RTT_MAX_LEVEL, memcache);
 	}
 
 	for (size = 0; size < map_size; size += RMM_PAGE_SIZE) {
+		pr_info("realm_map_protected_shared: loop size=0x%lx ipa=0x%lx phys=0x%llx\n",
+			size, ipa, (unsigned long long)phys);
 		if (rmi_granule_delegate(phys)) {
+			pr_info("realm_map_protected_shared: rmi_granule_delegate(0x%llx) FAILED (race?) returning 0\n",
+				(unsigned long long)phys);
 			/*
 			 * It's likely we raced with another VCPU on the same
 			 * fault. Assume the other VCPU has handled the fault
@@ -999,42 +1057,67 @@ int realm_map_protected_shared(struct realm *realm,
 			 */
 			return 0;
 		}
+		pr_info("realm_map_protected_shared: delegated phys=0x%llx\n",
+			(unsigned long long)phys);
 
 		ret = rmi_data_create_unknown_shared(rd, phys, ipa);
+		pr_info("realm_map_protected_shared: rmi_data_create_unknown_shared(rd=0x%llx, phys=0x%llx, ipa=0x%lx) ret=0x%x status=%d index=%d\n",
+			(unsigned long long)rd,
+			(unsigned long long)phys,
+			ipa,
+			ret,
+			RMI_RETURN_STATUS(ret),
+			RMI_RETURN_INDEX(ret));
 
 		if (RMI_RETURN_STATUS(ret) == RMI_ERROR_RTT) {
 			/* Create missing RTTs and retry */
 			int level = RMI_RETURN_INDEX(ret);
+			pr_info("realm_map_protected_shared: RMI_ERROR_RTT level=%d ipa=0x%lx phys=0x%llx\n",
+				level, ipa, (unsigned long long)phys);
 
 			WARN_ON(level == RMM_RTT_MAX_LEVEL);
 
 			ret = realm_create_rtt_levels(realm, ipa, level,
 						      RMM_RTT_MAX_LEVEL,
 						      memcache);
-			if (ret)
+			if (ret) {
+				pr_info("realm_map_protected_shared: realm_create_rtt_levels (retry) failed ret=%d\n", ret);
 				goto err_undelegate;
+			}
 
 			ret = rmi_data_create_unknown_shared(rd, phys, ipa);
 		}
 
-		if (WARN_ON(ret))
+		if (WARN_ON(ret)) {
+			pr_info("realm_map_protected_shared: final ret non-zero (0x%x) for ipa=0x%lx phys=0x%llx, jumping to err_undelegate\n",
+			       ret, ipa, (unsigned long long)phys);
 			goto err_undelegate;
+		}
 
 		phys += RMM_PAGE_SIZE;
 		ipa += RMM_PAGE_SIZE;
 	}
 
 	if (map_size == RMM_L2_BLOCK_SIZE) {
+		pr_info("realm_map_protected_shared: folding RTT for base_ipa=0x%lx map_level+1=%d\n",
+			base_ipa, map_level + 1);
 		ret = fold_rtt(realm, base_ipa, map_level + 1);
-		if (WARN_ON(ret))
+		if (WARN_ON(ret)) {
+			pr_err("realm_map_protected_shared: fold_rtt failed ret=%d\n", ret);
 			goto err;
+		}
 	}
-
+	pr_info("realm_map_protected_shared: SUCCESS for base_ipa=0x%lx map_size=0x%lx\n",
+		base_ipa, map_size);
 	return 0;
 
 err_undelegate:
+	pr_info("realm_map_protected_shared: err_undelegate phys=0x%llx size=0x%lx ipa=0x%lx\n",
+	       (unsigned long long)phys, size, ipa);
+
 	if (WARN_ON(rmi_granule_undelegate(phys))) {
-		/* Page can't be returned to NS world so is lost */
+		pr_info("realm_map_protected_shared: rmi_granule_undelegate(0x%llx) FAILED, leaking page\n",
+		       (unsigned long long)phys);
 		get_page(phys_to_page(phys));
 	}
 err:
@@ -1045,13 +1128,21 @@ int realm_map_protected_shared(struct realm *realm,
 		size -= RMM_PAGE_SIZE;
 		ipa -= RMM_PAGE_SIZE;
 
+		pr_info("realm_map_protected_shared: unwind destroying ipa=0x%lx phys=0x%llx size=0x%lx\n",
+			ipa, (unsigned long long)phys, size);
+
+
 		WARN_ON(rmi_data_destroy(rd, ipa, &data, &top));
 
 		if (WARN_ON(rmi_granule_undelegate(phys))) {
+			pr_info("realm_map_protected_shared: unwind rmi_granule_undelegate(0x%llx) FAILED, leaking page\n",
+			       (unsigned long long)phys);
 			/* Page can't be returned to NS world so is lost */
 			get_page(phys_to_page(phys));
 		}
 	}
+	pr_info("realm_map_protected_shared: EXIT with -ENXIO base_ipa=0x%lx\n", base_ipa);
+
 	return -ENXIO;
 }
 
@@ -1411,12 +1502,14 @@ int realm_bind_protected_shared(struct realm *realm,
 						      RMM_RTT_MAX_LEVEL,
 						      memcache);
 			if (ret)
+				// return ret;
 				goto err_undelegate;
 
 			ret = rmi_bind_protected_shared(virt_to_phys(realm->rd), phys, ipa);
 		}
 
 		if (WARN_ON(ret))
+			// return ret;
 			goto err_undelegate;
 
 		phys += RMM_PAGE_SIZE;
@@ -1532,6 +1625,12 @@ static int kvm_create_realm(struct kvm *kvm)
 		return ret;
 	}
 
+	ret = realm_create_pd(kvm);
+	if (ret) {
+		rme_vmid_release(realm->vmid);
+		return ret;
+	}
+
 	WRITE_ONCE(realm->state, REALM_STATE_NEW);
 
 	/* The realm is up, free the parameters.  */
