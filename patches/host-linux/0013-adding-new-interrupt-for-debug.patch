From 024d695bd0ae3d1975554699e38bf46bcb8483f4 Mon Sep 17 00:00:00 2001
From: Amir Al Sadi <alsadi.amir@gmail.com>
Date: Tue, 23 Dec 2025 17:15:05 +0000
Subject: [PATCH 13/14] adding new interrupt for debug

---
 arch/arm64/kvm/arm.c       | 113 +++++++++++++++++++++++++++++++++++++
 arch/arm64/kvm/rme.c       |  10 ++++
 arch/arm64/kvm/vgic/vgic.c |  40 +++++++++++++
 3 files changed, 163 insertions(+)

diff --git a/arch/arm64/kvm/arm.c b/arch/arm64/kvm/arm.c
index 7c85f6407775..4199c9190748 100644
--- a/arch/arm64/kvm/arm.c
+++ b/arch/arm64/kvm/arm.c
@@ -48,6 +48,9 @@
 #include <kvm/arm_pmu.h>
 #include <kvm/arm_psci.h>
 
+#include <linux/debugfs.h>
+#include <linux/ctype.h>
+
 #include "sys_regs.h"
 
 static enum kvm_mode kvm_mode = KVM_MODE_DEFAULT;
@@ -84,6 +87,112 @@ int kvm_arch_vcpu_should_kick(struct kvm_vcpu *vcpu)
 	return kvm_vcpu_exiting_guest_mode(vcpu) == IN_GUEST_MODE;
 }
 
+#include <linux/printk.h>
+#include <linux/kvm_host.h>
+
+static void kick_vcpus_for_irq(struct kvm *kvm, struct kvm_vcpu *target_vcpu)
+{
+	if (target_vcpu) {
+		kvm_make_request(KVM_REQ_IRQ_PENDING, target_vcpu);
+		kvm_vcpu_kick(target_vcpu);
+		return;
+	}
+
+	/* SPI case: broadcast kick so a vCPU re-enters and sees the interrupt */
+	{
+		struct kvm_vcpu *vcpu;
+		unsigned long i;
+
+		kvm_for_each_vcpu(i, vcpu, kvm) {
+			kvm_make_request(KVM_REQ_IRQ_PENDING, vcpu);
+			kvm_vcpu_kick(vcpu);
+		}
+	}
+}
+
+static ssize_t kvm_debugfs_inject_irq_write(struct file *file,
+					    const char __user *ubuf,
+					    size_t len, loff_t *ppos)
+{
+	struct kvm *kvm = file->private_data;
+	char buf[64];
+	unsigned long intid, vcpu_id = 0;
+	bool have_vcpu = false;
+	bool pulse = true; /* default: raise then drop */
+	struct kvm_vcpu *vcpu = NULL;
+
+	if (len == 0)
+		return 0;
+	if (len >= sizeof(buf))
+		len = sizeof(buf) - 1;
+
+	if (copy_from_user(buf, ubuf, len))
+		return -EFAULT;
+	buf[len] = '\0';
+
+	if (strnstr(buf, "vcpu", len)) {
+		char *p = strnstr(buf, "vcpu", len);
+		if (p && sscanf(p, "vcpu %lu", &vcpu_id) == 1)
+			have_vcpu = true;
+	}
+
+	if (strnstr(buf, "level 1", len))
+		pulse = false;
+	if (strnstr(buf, "pulse 0", len))
+		pulse = false;
+
+	if (strnstr(buf, "spi", len)) {
+		char *p = strnstr(buf, "spi", len);
+		if (!p || sscanf(p, "spi %lu", &intid) != 1)
+			return -EINVAL;
+	} else if (strnstr(buf, "ppi", len)) {
+		char *p = strnstr(buf, "ppi", len);
+		if (!p || sscanf(p, "ppi %lu", &intid) != 1)
+			return -EINVAL;
+	} else {
+		if (kstrtoul(buf, 0, &intid))
+			return -EINVAL;
+	}
+
+	/* PPI must be targeted */
+	if (intid >= 16 && intid < 32) {
+		if (!have_vcpu)
+			return -EINVAL;
+		vcpu = kvm_get_vcpu(kvm, vcpu_id);
+		if (!vcpu)
+			return -EINVAL;
+	}
+
+	/* Basic sanity logs: proves the handler ran and how it interpreted input */
+	pr_info("kvm/inject_irq: cmd='%s' intid=%lu type=%s pulse=%d vcpu=%s%lu\n",
+		buf, intid,
+		(intid < 32) ? "PPI/SGI" : "SPI",
+		pulse,
+		vcpu ? "" : "(all) ",
+		vcpu ? vcpu_id : 0);
+
+	/* Assert */
+	kvm_vgic_inject_irq(kvm, vcpu, (unsigned int)intid, true, NULL);
+
+	/* Deassert if pulsing */
+	if (pulse)
+		kvm_vgic_inject_irq(kvm, vcpu, (unsigned int)intid, false, NULL);
+
+	/* Critical: ensure vCPU(s) re-enter and see pending IRQs */
+	kick_vcpus_for_irq(kvm, vcpu);
+
+	return len;
+}
+
+
+static const struct file_operations kvm_debugfs_inject_irq_fops = {
+	.owner = THIS_MODULE,
+	.open  = simple_open,
+	.write = kvm_debugfs_inject_irq_write,
+	.llseek = noop_llseek,
+};
+
+
 int kvm_vm_ioctl_enable_cap(struct kvm *kvm,
 			    struct kvm_enable_cap *cap)
 {
@@ -244,6 +353,10 @@ void kvm_arch_create_vm_debugfs(struct kvm *kvm)
 {
 	kvm_sys_regs_create_debugfs(kvm);
 	kvm_s2_ptdump_create_debugfs(kvm);
+	if (kvm->debugfs_dentry) {
+		debugfs_create_file("inject_irq", 0200, kvm->debugfs_dentry,
+				    kvm, &kvm_debugfs_inject_irq_fops);
+	}
 }
 
 static void kvm_destroy_mpidr_data(struct kvm *kvm)
diff --git a/arch/arm64/kvm/rme.c b/arch/arm64/kvm/rme.c
index 652c79eb357e..90a96743efef 100644
--- a/arch/arm64/kvm/rme.c
+++ b/arch/arm64/kvm/rme.c
@@ -1770,6 +1770,16 @@ void kvm_destroy_realm(struct kvm *kvm)
 		realm->rd = NULL;
 	}
 
+	//destroying PD must be after destroying RD
+	if (realm->pd) {
+		phys_addr_t pd_phys = virt_to_phys(realm->pd);
+
+		if (WARN_ON(rmi_realm_destroy(pd_phys)))
+			return;
+		free_delegated_granule(pd_phys);
+		realm->pd = NULL;
+	}
+
 	rme_vmid_release(realm->vmid);
 
 	for (i = 0; i < pgd_size; i += RMM_PAGE_SIZE) {
diff --git a/arch/arm64/kvm/vgic/vgic.c b/arch/arm64/kvm/vgic/vgic.c
index 2908b4610c4e..aaa92b3accf0 100644
--- a/arch/arm64/kvm/vgic/vgic.c
+++ b/arch/arm64/kvm/vgic/vgic.c
@@ -445,6 +445,13 @@ int kvm_vgic_inject_irq(struct kvm *kvm, struct kvm_vcpu *vcpu,
 	unsigned long flags;
 	int ret;
 
+	if(intid == 48){
+		pr_info("KVM/VGIC inject: kvm=%p vcpu=%p%s intid=%u level=%d\n",
+			kvm, vcpu,
+			vcpu ? "" : "(broadcast)",
+			intid, level);
+	}
+
 	ret = vgic_lazy_init(kvm);
 	if (ret)
 		return ret;
@@ -922,11 +929,42 @@ void kvm_vgic_sync_hwstate(struct kvm_vcpu *vcpu)
 	vgic_prune_ap_list(vcpu);
 }
 
+static inline u32 ich_lr_vintid(u64 lr)
+{
+        return (u32)(lr & 0xffffffffULL);
+}
+
+static inline u32 ich_lr_state(u64 lr)
+{
+        return (u32)((lr >> 62) & 0x3ULL);
+}
+
+static void vgic_rmm_dump_lrs(struct kvm_vcpu *vcpu, const char *tag, u64 *lrs, int n)
+{
+        int i;
+
+        for (i = 0; i < n; i++) {
+                u64 lr = lrs[i];
+                if (!lr)
+                        continue;
+				if(ich_lr_vintid(lr) == 80){
+					pr_info("KVM/RME %s: vcpu=%d lr[%d]=0x%016llx vintid=%u state=%u\n",
+							tag, vcpu->vcpu_idx, i,
+							(unsigned long long)lr,
+							ich_lr_vintid(lr),
+							ich_lr_state(lr));
+				}
+        }
+}
+
 static inline void vgic_rmm_restore_state(struct kvm_vcpu *vcpu)
 {
 	struct vgic_v3_cpu_if *cpu_if = &vcpu->arch.vgic_cpu.vgic_v3;
 	int i;
 
+	/* BEFORE copy: dump vgic’s LR set (source) */
+	vgic_rmm_dump_lrs(vcpu, "src", cpu_if->vgic_lr, VGIC_V3_MAX_LRS);
+
 	for (i = 0; i < kvm_vcpu_vgic_nr_lr(vcpu); i++) {
 		vcpu->arch.rec.run->enter.gicv3_lrs[i] = cpu_if->vgic_lr[i];
 		/*
@@ -936,6 +974,8 @@ static inline void vgic_rmm_restore_state(struct kvm_vcpu *vcpu)
 		 */
 		vcpu->arch.rec.run->exit.gicv3_lrs[i] = cpu_if->vgic_lr[i];
 	}
+	/* AFTER copy: dump what will be passed to RMM (destination) */
+	vgic_rmm_dump_lrs(vcpu, "dst", vcpu->arch.rec.run->enter.gicv3_lrs, kvm_vcpu_vgic_nr_lr(vcpu));
 
 	vcpu->arch.rec.run->enter.gicv3_hcr = cpu_if->vgic_hcr & RMI_PERMITTED_GICV3_HCR_BITS;
 }
