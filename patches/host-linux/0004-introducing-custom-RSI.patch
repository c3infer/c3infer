From cfb67be03d631a89c87ff3b8881b84dc46ca9d6b Mon Sep 17 00:00:00 2001
From: Amir Al Sadi <alsadi.amir@gmail.com>
Date: Tue, 21 Oct 2025 15:24:12 +0100
Subject: [PATCH 04/14] introducing custom RSI

---
 arch/arm64/include/asm/rsi_cmds.h | 20 ++++++++++++++++++++
 arch/arm64/include/asm/rsi_smc.h  |  8 ++++++++
 arch/arm64/kernel/rsi.c           |  2 ++
 3 files changed, 30 insertions(+)

diff --git a/arch/arm64/include/asm/rsi_cmds.h b/arch/arm64/include/asm/rsi_cmds.h
index 2c8763876dfb..cc3636a1b4f6 100644
--- a/arch/arm64/include/asm/rsi_cmds.h
+++ b/arch/arm64/include/asm/rsi_cmds.h
@@ -22,6 +22,17 @@ enum ripas {
 	RSI_RIPAS_DEV = 3,
 };
 
+static inline void invoke_rsi_fn_smc_with_res(unsigned long function_id,
+                                              unsigned long arg0,
+                                              unsigned long arg1,
+                                              unsigned long arg2,
+                                              unsigned long arg3,
+                                              struct arm_smccc_res *res)
+{
+    arm_smccc_smc(function_id, arg0, arg1, arg2, arg3, 0, 0, 0, res);
+}
+
+
 static inline unsigned long rsi_request_version(unsigned long req,
 						unsigned long *out_lower,
 						unsigned long *out_higher)
@@ -38,6 +49,15 @@ static inline unsigned long rsi_request_version(unsigned long req,
 	return res.a0;
 }
 
+static inline unsigned long rsi_custom_print(unsigned long req)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_smc(SMC_RSI_CUSTOM_PRINT, req, 0, 0, 0, 0, 0, 0, &res);
+	return res.a0;
+}
+
+
 static inline unsigned long rsi_get_realm_config(struct realm_config *cfg)
 {
 	struct arm_smccc_res res;
diff --git a/arch/arm64/include/asm/rsi_smc.h b/arch/arm64/include/asm/rsi_smc.h
index 6cb070eca9e9..7e4da43c5d46 100644
--- a/arch/arm64/include/asm/rsi_smc.h
+++ b/arch/arm64/include/asm/rsi_smc.h
@@ -190,4 +190,12 @@ struct realm_config {
  */
 #define SMC_RSI_HOST_CALL			SMC_RSI_FID(0x199)
 
+/*
+ * Custom print from within a Realm.
+ *
+ * ret0 == Status / error
+ */
+#define SMC_RSI_CUSTOM_PRINT                     SMC_RSI_FID(0x1B0)
+
+
 #endif /* __ASM_RSI_SMC_H_ */
diff --git a/arch/arm64/kernel/rsi.c b/arch/arm64/kernel/rsi.c
index ce4778141ec7..57160ea84ee1 100644
--- a/arch/arm64/kernel/rsi.c
+++ b/arch/arm64/kernel/rsi.c
@@ -126,6 +126,8 @@ void __init arm64_rsi_init(void)
 		return;
 	if (!rsi_version_matches())
 		return;
+	if (rsi_custom_print(1) != RSI_SUCCESS)
+		return;
 	if (WARN_ON(rsi_get_realm_config(&config)))
 		return;
 	prot_ns_shared = BIT(config.ipa_bits - 1);
-- 
2.34.1

