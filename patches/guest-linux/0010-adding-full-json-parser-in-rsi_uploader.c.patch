@@ -3,35 +3,7 @@
 // rsi_policy_json.c
 // Read a fixed-shape JSON policy and tell the RMM where the resulting
 // binary buffer lives (IPA == page address)
-//
-// expected JSON:
-//
-// {
-//   "Self": "VM1",
-//   "VM1": { "hash": 0xffaaa1, "allowed-untrusted": false },
-//   "VM2": { "hash": 0xffaaa2, "allowed-untrusted": false },
-//   "PS12": {
-//     "size": 0x1000,
-//     "mappings": [
-//       "VM1": { "gpa": 0x4000, "prot": RW },
-//       "VM2": { "gpa": 0x7000, "prot": R  }
-//     ]
-//   }
-// }
-//
-// we turn that into the binary the RMM parser expects:
-//
-// u32 magic = 'PAYL'
-// u16 version = 1
-// u16 self_vm_index (0 for VM1, 1 for VM2, 0xffff for none)
-// u16 num_vms = 2
-// u16 num_ps  = 1
-// u16 reserved = 0
-// ---- VM1 rec (12B) ----
-// ---- VM2 rec (12B) ----
-// ---- PS12 + 2 mappings ----
-//
-// then we do SMC(RSI_PARSE_CONFIG, ipa)
+
 
