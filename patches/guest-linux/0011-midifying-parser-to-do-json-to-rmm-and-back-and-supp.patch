+/* ---------- Read helpers (little endian) ---------- */
+
+static unsigned short rd_u16(const unsigned char *p)
+{
+    return (unsigned short)p[0] | ((unsigned short)p[1] << 8);
+}
+
+static unsigned int rd_u32(const unsigned char *p)
+{
+    return (unsigned int)p[0]
+         | ((unsigned int)p[1] << 8)
+         | ((unsigned int)p[2] << 16)
+         | ((unsigned int)p[3] << 24);
+}
+
+static unsigned long long rd_u64(const unsigned char *p)
+{
+    unsigned long long v = 0;
+    v |= (unsigned long long)p[0];
+    v |= (unsigned long long)p[1] << 8;
+    v |= (unsigned long long)p[2] << 16;
+    v |= (unsigned long long)p[3] << 24;
+    v |= (unsigned long long)p[4] << 32;
+    v |= (unsigned long long)p[5] << 40;
+    v |= (unsigned long long)p[6] << 48;
+    v |= (unsigned long long)p[7] << 56;
+    return v;
+}
+
+/* ---------- Small stringify helpers ---------- */
+
+static void name4_to_cstr(const char name4[4], char out[5])
+{
+    int i, p = 0;
+    for (i = 0; i < 4; i++) {
+        if (!name4[i])
+            break;
+        out[p++] = name4[i];
+    }
+    out[p] = '\0';
+}
+
+static void props_to_str(unsigned int props, char *out, size_t outsz)
+{
+    size_t pos = 0;
+
+    if (!outsz)
+        return;
+    out[0] = '\0';
+
+    if (props & PS_PROP_PROTECTED)
+        pos += scnprintf(out + pos, outsz - pos, "PROTECTED");
+    if (props & PS_PROP_FRESH) {
+        if (pos && pos < outsz)
+            pos += scnprintf(out + pos, outsz - pos, "|");
+        pos += scnprintf(out + pos, outsz - pos, "FRESH");
+    }
+}
+
+static const char *onremove_to_str(unsigned short v)
+{
+    switch (v) {
+    case PS_ON_REMOVE_CLEAN: return "CLEAN";
+    case PS_ON_REMOVE_NONE:  return "NONE";
+    default:                 return "NONE";
+    }
+}
+
+static const char *mapped_to_str(unsigned short v)
+{
+    switch (v) {
+    case PS_MAPPED_NONE:    return "NONE";
+    case PS_MAPPED_PENDING: return "PENDING";
+    case PS_MAPPED_ACTIVE:  return "ACTIVE";
+    default:                return "NONE";
+    }
+}
+
+static const char *prot_to_str(unsigned short prot)
+{
+    switch (prot) {
+    case PROT_RW: return "RW";
+    case PROT_R:  return "R";
+    case PROT_W:  return "W";
+    default:      return "";
+    }
+}
