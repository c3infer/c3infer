+static int rmm_payload_to_json(const unsigned char *buf, size_t len,
+                               char *out, size_t out_cap)
+{
+    const unsigned char *p, *end;
+    unsigned int magic;
+    unsigned short version, self_idx, num_vms, num_ps;
+    unsigned short i, mi;
+
+    struct vm_tmp {
+        char name4[4];
+        unsigned int hash;
+        unsigned char allowed_untrusted;
+        unsigned char allowed_other_mappings;
+    };
+
+    struct ps_tmp {
+        char name4[4];
+        unsigned int size;
+        unsigned int properties;
+        unsigned short owner_vm_index;
+        unsigned short on_remove;
+        unsigned short mapped;
+        unsigned short num_maps;
+        const unsigned char *maps_base; /* points to first map */
+    };
+
+    struct vm_tmp vms[PARSER_MAX_VMS];
+    struct ps_tmp ps[PARSER_MAX_PS];
+
+    size_t pos = 0;
+
+    if (!buf || !out || !out_cap)
+        return -EINVAL;
+
+    if (len < 16)
+        return -EINVAL;
+
+    p   = buf;
+    end = buf + len;
+
+    magic   = rd_u32(p + 0);
+    version = rd_u16(p + 4);
+    self_idx = rd_u16(p + 6);
+    num_vms  = rd_u16(p + 8);
+    num_ps   = rd_u16(p + 10);
+    /* p+12..p+15 reserved */
+    p += 16;
+
+    if (magic != PAYLOAD_MAGIC)
+        return -EINVAL;
+    if (version != 1)
+        return -EINVAL;
+    if (num_vms > PARSER_MAX_VMS || num_ps > PARSER_MAX_PS)
+        return -EINVAL;
+
+    if (self_idx >= num_vms)
+        return -EINVAL;
+
+    /* Read VMs */
+    for (i = 0; i < num_vms; i++) {
+        struct vm_tmp *v;
+
+        if (p + 12 > end)
+            return -EINVAL;
+
+        v = &vms[i];
+        memcpy(v->name4, p + 0, 4);
+        v->hash = rd_u32(p + 4);
+        v->allowed_untrusted       = p[8];
+        v->allowed_other_mappings  = p[9];
+        /* p[10], p[11] reserved */
+        p += 12;
+    }
+
+    /* Read PS entries */
+    for (i = 0; i < num_ps; i++) {
+        struct ps_tmp *psp;
+        size_t maps_bytes;
+
+        if (p + 12 > end)
+            return -EINVAL;
+
+        psp = &ps[i];
+        memcpy(psp->name4, p + 0, 4);
+        psp->size     = rd_u32(p + 4);
+        psp->num_maps = rd_u16(p + 8);
+        /* p+10..p+11 pad */
+        p += 12;
+
+        if (p + 12 > end)
+            return -EINVAL;
+
+        psp->properties      = rd_u32(p + 0);
+        psp->owner_vm_index  = rd_u16(p + 4);
+        psp->on_remove       = rd_u16(p + 6);
+        psp->mapped          = rd_u16(p + 8);
+        /* p+10..p+11 pad */
+        p += 12;
+
+        maps_bytes = (size_t)psp->num_maps * 12;
+        if (p + maps_bytes > end)
+            return -EINVAL;
+
+        psp->maps_base = p;
+        p += maps_bytes;
+    }
+
+    /* Build JSON text */
+#define APPEND(fmt, ...) \
+    do { \
+        if (pos < out_cap) \
+            pos += scnprintf(out + pos, out_cap - pos, fmt, ##__VA_ARGS__); \
+    } while (0)
+
+    APPEND("{\n");
+
+    /* Self */
+    {
+        char self_name[5];
+        name4_to_cstr(vms[self_idx].name4, self_name);
+        APPEND("  \"Self\": \"%s\"", self_name);
+    }
+
+    /* VMs */
+    for (i = 0; i < num_vms; i++) {
+        char vm_name[5];
+        struct vm_tmp *v = &vms[i];
+
+        name4_to_cstr(v->name4, vm_name);
+        APPEND(",\n  \"%s\": { \"hash\": 0x%x, "
+               "\"allowed-untrusted\": %s, "
+               "\"allowed-other-mappings\": %s }",
+               vm_name,
+               v->hash,
+               v->allowed_untrusted ? "true" : "false",
+               v->allowed_other_mappings ? "true" : "false");
+    }
+
+    /* PS entries */
+    for (i = 0; i < num_ps; i++) {
+        struct ps_tmp *psp = &ps[i];
+        char ps_name[5];
+        char props_str[32];
+        const char *onrm_str;
+        const char *mapped_str;
+        char owner_name[5];
+
+        name4_to_cstr(psp->name4, ps_name);
+        props_to_str(psp->properties, props_str, sizeof(props_str));
+        onrm_str   = onremove_to_str(psp->on_remove);
+        mapped_str = mapped_to_str(psp->mapped);
+
+        if (psp->owner_vm_index < num_vms)
+            name4_to_cstr(vms[psp->owner_vm_index].name4, owner_name);
+        else
+            owner_name[0] = '\0';
+
+        APPEND(",\n  \"%s\": {\n", ps_name);
+        APPEND("    \"size\": 0x%x,\n", psp->size);
+        APPEND("    \"properties\": \"%s\",\n", props_str);
+        APPEND("    \"on-remove\": \"%s\",\n", onrm_str);
+        APPEND("    \"owner\": \"%s\",\n", owner_name);
+        APPEND("    \"mapped\": \"%s\",\n", mapped_str);
+        APPEND("    \"mappings\": {\n");
+
+        /* Mappings */
+        for (mi = 0; mi < psp->num_maps; mi++) {
+            const unsigned char *mp = psp->maps_base + mi * 12;
+            unsigned short vm_idx = rd_u16(mp + 0);
+            unsigned short prot   = rd_u16(mp + 2);
+            unsigned long long gpa = rd_u64(mp + 4);
+            char map_vm_name[5];
+            const char *prot_str = prot_to_str(prot);
+
+            if (vm_idx < num_vms)
+                name4_to_cstr(vms[vm_idx].name4, map_vm_name);
+            else
+                snprintf(map_vm_name, sizeof(map_vm_name), "VM%u", vm_idx);
+
+            APPEND("      \"%s\": { \"gpa\": 0x%llx, \"prot\": \"%s\" }%s\n",
+                   map_vm_name,
+                   gpa,
+                   prot_str,
+                   (mi + 1 < psp->num_maps) ? "," : "");
+        }
+
+        APPEND("    }\n  }");
+    }
+
+    APPEND("\n}\n");
+
+    /* Ensure NUL-termination */
+    if (out_cap)
+        out[min(pos, out_cap - 1)] = '\0';
+
+#undef APPEND
+    return 0;
+}
+
+
 
