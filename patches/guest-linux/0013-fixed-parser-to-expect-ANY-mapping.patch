From ffc2c8b92215f04d7b8cc408d3ec9b171f08c025 Mon Sep 17 00:00:00 2001
From: Amir Al Sadi <alsadi.amir@gmail.com>
Date: Fri, 28 Nov 2025 18:08:27 +0000
Subject: [PATCH 13/18] fixed parser to expect ANY mapping

---
 drivers/misc/rsi_uploader.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/drivers/misc/rsi_uploader.c b/drivers/misc/rsi_uploader.c
index 9e21f819d1ae..c1b0acd9c816 100644
--- a/drivers/misc/rsi_uploader.c
+++ b/drivers/misc/rsi_uploader.c
@@ -44,6 +44,7 @@ MODULE_PARM_DESC(rsi_fid, "RSI SMC function ID for rsi_parse_config");
 /* ---- Constants matching your RMM stub ---- */
 #define PAYLOAD_MAGIC 0x5041594cU /* 'PAYL' */
 #define BIN_PAGE_SIZE PAGE_SIZE
+#define VM_IDX_ANY 0xFFFFu
 
 enum { PROT_R = 1, PROT_W = 2, PROT_RW = 3 };
 enum { PS_PROP_PROTECTED = 1u << 0, PS_PROP_FRESH = 1u << 1 };
@@ -613,6 +614,15 @@ static int resolve_indices(struct st_ctx *ctx)
 
         for (mi = 0; mi < ps->num_maps; mi++) {
             struct st_map *m = &ps->maps[mi];
+
+            /* Special-case wildcard */
+            if (!strcmp(m->vm_name_tmp, "ANY")) {
+                m->vm_index = VM_IDX_ANY;
+                pr_info("mapping PS[%u] entry[%u] to ANY (vm_index=0x%04x)\n",
+                        (unsigned)pi, (unsigned)mi, (unsigned)m->vm_index);
+                continue;
+            }
+            
             if (find_vm_index_by_cstr(ctx, m->vm_name_tmp, &m->vm_index)) {
                 pr_info("ERROR: mapping VM '%s' not found for PS[%u]\n",
                         m->vm_name_tmp, (unsigned)pi);
-- 
