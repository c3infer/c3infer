+        APPEND("    \"owner\": \"%s\",\n", owner_name);
+        APPEND("    \"range\": %s,\n", range_json);
+        APPEND("    \"policy\": \"%s\"\n", pol_str);
+        APPEND("  }");
+    }
+
+
     APPEND("\n}\n");
 
