+static void ch_range_to_json(unsigned short mask, char *out, size_t outsz)
+{
+    size_t pos = 0;
+    if (!outsz) return;
+    out[0] = '\0';
+
+    pos += scnprintf(out + pos, outsz - pos, "[");
+
+    if (mask & CH_RANGE_RSI) {
+        pos += scnprintf(out + pos, outsz - pos, "\"RSI\"");
+        if (mask & CH_RANGE_OTHER)
+            pos += scnprintf(out + pos, outsz - pos, ", ");
+    }
+    if (mask & CH_RANGE_OTHER)
+        pos += scnprintf(out + pos, outsz - pos, "\"OTHER\"");
+
+    scnprintf(out + pos, outsz - pos, "]");
+}
 
