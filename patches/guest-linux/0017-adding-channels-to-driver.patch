+static int ch_policy_from_str(const char *s, unsigned short *out)
+{
+    if (!strcmp(s, "SCRUB"))    { *out = CH_POLICY_SCRUB; return 0; }
+    if (!strcmp(s, "BLOCK"))    { *out = CH_POLICY_BLOCK; return 0; }
+    if (!strcmp(s, "DELEGATE")) { *out = CH_POLICY_DELEGATE; return 0; }
+    return -EINVAL;
+}
+
+static int parse_ch_range_array(struct js *j, unsigned short *out_mask)
+{
+    unsigned short mask = 0;
+
+    if (js_expect(j, '[')) return -EINVAL;
+
+    while (1) {
+        char c;
+        js_skip(j);
+        if (js_peek(j, &c)) return -EINVAL;
+        if (c == ']') { j->i++; break; }
+
+        {
+            char s[16];
+            if (js_string(j, s, sizeof(s))) return -EINVAL;
+            if (!strcmp(s, "RSI"))      mask |= CH_RANGE_RSI;
+            else if (!strcmp(s, "OTHER")) mask |= CH_RANGE_OTHER;
+            else return -EINVAL;
+        }
+
+        if (!js_maybe(j, ',')) {
+            if (js_expect(j, ']')) return -EINVAL;
+            break;
+        }
+    }
+
+    *out_mask = mask;
+    return 0;
+}
