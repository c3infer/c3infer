+static int parse_ch_obj(struct js *j, struct st_ch *ch)
+{
+    if (js_expect(j, '{')) return -EINVAL;
+
+    while (1) {
+        if (js_maybe(j, '}')) break;
+
+        {
+            char key[32];
+            if (js_string(j, key, sizeof(key))) return -EINVAL;
+            if (js_expect(j, ':')) return -EINVAL;
+
+            if (!strcmp(key, "owner")) {
+                char owner[16];
+                if (js_string(j, owner, sizeof(owner))) return -EINVAL;
+                k_strscpy(ch->owner_name_tmp, owner, sizeof(ch->owner_name_tmp));
+            } else if (!strcmp(key, "range")) {
+                unsigned short m;
+                if (parse_ch_range_array(j, &m)) return -EINVAL;
+                ch->range_mask = m;
+            } else if (!strcmp(key, "policy")) {
+                char pol[16];
+                unsigned short pv;
+                if (js_string(j, pol, sizeof(pol))) return -EINVAL;
+                if (ch_policy_from_str(pol, &pv)) return -EINVAL;
+                ch->policy = pv;
+            } else {
+                return -EINVAL;
+            }
+        }
+
+        if (!js_maybe(j, ',')) {
+            if (js_expect(j, '}')) return -EINVAL;
+            break;
+        }
+    }
+
+    return 0;
+}
