From b2c0c690f5c20b179dfcddcd460dd1ac7de9cb6c Mon Sep 17 00:00:00 2001
From: Amir Al Sadi <alsadi.amir@gmail.com>
Date: Tue, 23 Dec 2025 17:15:36 +0000
Subject: [PATCH 15/18] adding new interrupt for debug

---
 arch/arm64/configs/rsi_support_defconfig |   1 +
 drivers/misc/Kconfig                     |   5 ++
 drivers/misc/Makefile                    |   1 +
 drivers/misc/kvm_spi_test.c              | 105 +++++++++++++++++++++++
 4 files changed, 112 insertions(+)
 create mode 100644 drivers/misc/kvm_spi_test.c

diff --git a/arch/arm64/configs/rsi_support_defconfig b/arch/arm64/configs/rsi_support_defconfig
index 644e7895efad..03e71b658874 100644
--- a/arch/arm64/configs/rsi_support_defconfig
+++ b/arch/arm64/configs/rsi_support_defconfig
@@ -294,6 +294,7 @@ CONFIG_QCOM_FASTRPC=m
 CONFIG_SRAM=y
 CONFIG_PCI_ENDPOINT_TEST=m
 CONFIG_RSI_UPLOADER=y
+CONFIG_KVM_SPI_TEST=y
 CONFIG_EEPROM_AT24=m
 CONFIG_EEPROM_AT25=m
 CONFIG_UACCE=m
diff --git a/drivers/misc/Kconfig b/drivers/misc/Kconfig
index 931bded588e9..46eb04b8c572 100644
--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -648,6 +648,11 @@ config RSI_UPLOADER
     depends on ARM64
     help
       Reads a policy file and calls rsi_upload_policy() for each line.
+config KVM_SPI_TEST
+	tristate "KVM SPI test IRQ handler"
+	depends on ARM64 && OF
+	help
+	  Maps a GICv3 SPI INTID via irqdomain (no DT node) and prints when fired.
 
 source "drivers/misc/c2port/Kconfig"
 source "drivers/misc/eeprom/Kconfig"
diff --git a/drivers/misc/Makefile b/drivers/misc/Makefile
index f03b2b5f73e4..3ca38e2b0612 100644
--- a/drivers/misc/Makefile
+++ b/drivers/misc/Makefile
@@ -76,3 +76,4 @@ obj-$(CONFIG_MCHP_LAN966X_PCI)	+= lan966x-pci.o
 obj-y				+= keba/
 obj-y				+= amd-sbi/
 obj-$(CONFIG_RSI_UPLOADER) += rsi_uploader.o
+obj-$(CONFIG_KVM_SPI_TEST) += kvm_spi_test.o
diff --git a/drivers/misc/kvm_spi_test.c b/drivers/misc/kvm_spi_test.c
new file mode 100644
index 000000000000..714eb2ca5165
--- /dev/null
+++ b/drivers/misc/kvm_spi_test.c
@@ -0,0 +1,105 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/module.h>
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+#include <linux/irqdomain.h>
+#include <linux/of.h>
+
+static unsigned int intid = 48;     /* choose an unused SPI >= 32 */
+module_param(intid, uint, 0444);
+MODULE_PARM_DESC(intid, "SPI INTID to handle (>= 32)");
+
+static bool edge = false;
+module_param(edge, bool, 0444);
+MODULE_PARM_DESC(edge, "Use edge-rising trigger (default: level-high)");
+
+static int virq = -1;
+
+static irqreturn_t kvm_spi_test_irq(int irq, void *dev_id)
+{
+	struct irq_data *d = irq_get_irq_data(irq);
+	unsigned long hwirq = d ? irqd_to_hwirq(d) : ~0UL;
+
+	pr_info("kvm-spi-test: fired linux_irq=%d INTID=%lu\n", irq, hwirq);
+	return IRQ_HANDLED;
+}
+
+static struct irq_domain *find_gic_irqdomain(void)
+{
+	struct device_node *np;
+
+	np = of_find_compatible_node(NULL, NULL, "arm,gic-v3");
+	if (!np)
+		np = of_find_compatible_node(NULL, NULL, "arm,gic-v3r");
+	if (!np)
+		return NULL;
+
+	/* irq_find_host() uses the DT node; we can drop the node ref */
+	{
+		struct irq_domain *d = irq_find_host(np);
+		of_node_put(np);
+		return d;
+	}
+}
+
+static int __init kvm_spi_test_init(void)
+{
+	struct irq_domain *domain;
+	struct irq_fwspec fwspec;
+	u32 trig = edge ? IRQ_TYPE_EDGE_RISING : IRQ_TYPE_LEVEL_HIGH;
+	int ret;
+
+	if (intid < 32) {
+		pr_err("kvm-spi-test: INTID %u is not an SPI (need >= 32)\n", intid);
+		return -EINVAL;
+	}
+
+	domain = find_gic_irqdomain();
+	if (!domain) {
+		pr_err("kvm-spi-test: could not find GICv3 irqdomain\n");
+		return -ENODEV;
+	}
+
+	/* fwspec format matches the GIC DT interrupt specifier */
+	fwspec.fwnode = domain->fwnode;
+	fwspec.param_count = 3;
+	fwspec.param[0] = 0;      /* 0=SPI */
+	fwspec.param[1] = intid;  /* INTID */
+	fwspec.param[2] = trig;   /* trigger type */
+
+	virq = irq_create_fwspec_mapping(&fwspec);
+	if (virq <= 0) {
+		pr_err("kvm-spi-test: irq_create_fwspec_mapping failed for INTID %u (virq=%d)\n",
+		       intid, virq);
+		return -EINVAL;
+	}
+
+	ret = request_irq(virq, kvm_spi_test_irq, 0, "kvm-spi-test", NULL);
+	if (ret) {
+		pr_err("kvm-spi-test: request_irq failed virq=%d INTID=%u ret=%d\n",
+		       virq, intid, ret);
+		irq_dispose_mapping(virq);
+		virq = -1;
+		return ret;
+	}
+
+	pr_info("kvm-spi-test: installed handler INTID=%u as linux_irq=%d (%s)\n",
+		intid, virq, edge ? "edge" : "level");
+
+	return 0;
+}
+
+static void __exit kvm_spi_test_exit(void)
+{
+	if (virq > 0) {
+		free_irq(virq, NULL);
+		irq_dispose_mapping(virq);
+		pr_info("kvm-spi-test: removed handler (linux_irq=%d)\n", virq);
+	}
+}
+
+module_init(kvm_spi_test_init);
+module_exit(kvm_spi_test_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Map a GICv3 SPI INTID without DT node and print on interrupt");
-- 
