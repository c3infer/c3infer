index cc3636a1b4f6..4d362c7d6506 100644
--- a/arch/arm64/include/asm/rsi_cmds.h
+++ b/arch/arm64/include/asm/rsi_cmds.h
@@ -49,11 +49,12 @@ static inline unsigned long rsi_request_version(unsigned long req,
 	return res.a0;
 }
 
-static inline unsigned long rsi_custom_print(unsigned long req)
+static inline unsigned long rsi_upload_policy(phys_addr_t ipa, unsigned long size, 
+											  unsigned int local_acl, unsigned long target_realm, unsigned int target_acl)
 {
 	struct arm_smccc_res res;
 
-	arm_smccc_smc(SMC_RSI_CUSTOM_PRINT, req, 0, 0, 0, 0, 0, 0, &res);
+	arm_smccc_smc(SMC_RSI_UPLOAD_POLICY, ipa, size, local_acl, target_realm, target_acl, 0, 0, &res);
 	return res.a0;
 }
 
